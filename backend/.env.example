GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT auth. Generate a real secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is generated at process startup (dev-only fallback) —
# every issued token becomes invalid on restart.
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=120

# SQLite by default — a single file, no separate DB server required.
# Production uses TiDB Cloud: mysql+pymysql://USER:PASS@HOST:4000/docmind
DATABASE_URL=sqlite:///./app.db

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
MAX_RELEVANT_DISTANCE=0.40

MAX_FILE_SIZE_MB=20

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Version of the Terms new signups accept (keep equal to POLICY.termsVersion
# in frontend/src/config/site.js).
TERMS_VERSION=2026-10-11

# Outgoing SMTP for password-reset email. Leave unset for no email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=DocMind <no-reply@example.com>

# Local development only: return the reset link in the API response.
# Never set this in production.
# PASSWORD_RESET_DEMO_MODE=true
