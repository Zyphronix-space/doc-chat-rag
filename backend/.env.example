GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT auth. Generate a real secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is generated at process startup (dev-only fallback) —
# every issued token becomes invalid on restart.
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=120

# SQLite by default — a single file, no separate DB server required.
DATABASE_URL=sqlite:///./app.db

# Where uploaded documents' raw bytes are stored on disk, and Chroma's vector store path.
UPLOAD_DIR=uploads
CHROMA_PATH=chroma_db

MAX_FILE_SIZE_MB=20

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
